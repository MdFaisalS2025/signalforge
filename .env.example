# Copy to .env and adjust. No real secrets belong in this repo or in .env.example.

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=info

# --- Redpanda (Kafka API) ---
KAFKA_BROKERS=redpanda:9092

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=signalforge
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme-local-only

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=signalforge

# --- Orders/Payments observability slice (demo-orders, demo-payments) ---
# Not read via OTEL_EXPORTER_OTLP_ENDPOINT above — these services construct
# their OTLP/HTTP exporters with explicit per-signal URLs read directly from
# the three variables below (see docs/specs/2026-10-01-orders-payments-observability-slice.md, section 9).
PAYMENTS_URL=http://demo-payments:8082
PAYMENTS_TIMEOUT_MS=3000
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs

# --- demo-payments deployment and fault mode (all optional; Compose defaults shown) ---
# PAYMENTS_FAULT_MODE: "enabled" makes every POST /payments/charge return HTTP 500. Default: disabled.
# PAYMENTS_VERSION: reported as service.version. Default: 0.1.0.
# DEPLOYMENT_ENVIRONMENT: reported as deployment.environment.name. Default: local.
# DEPLOYMENT_ID: reported as deployment.id when non-empty. Set by scripts/deploy-payments.mjs.
PAYMENTS_FAULT_MODE=disabled
PAYMENTS_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=local
DEPLOYMENT_ID=

# --- collector-go acceptance-only hooks (default off; used by the Task 11 acceptance script) ---
# The collector-go service reads native port 9000 directly from Compose, so CLICKHOUSE_PORT above
# (8123, the HTTP port used by other tools) does not apply to it.
# INCIDENT_PUBLISH_FAIL_ATTEMPTS: the first N attempted incident produces fail without calling Kafka. Default: 0.
# INCIDENT_CRASH_AFTER_PRODUCE: 1 makes collector-go exit 1 after a successful produce and before the state
#   write, to test restart recovery. Only 0 or 1 are accepted. Default: 0.
INCIDENT_PUBLISH_FAIL_ATTEMPTS=0
INCIDENT_CRASH_AFTER_PRODUCE=0

# --- Agent / model provider (abstracted behind one typed adapter) ---
MODEL_PROVIDER=placeholder
MODEL_API_KEY=set-in-local-.env-only

# --- agent-python (evidence-cited diagnosis; docs/specs/2026-10-07-evidence-cited-diagnosis.md, sections 10 and 13) ---
# Compose supplies these defaults when a variable is unset or blank here. The agent connects to ClickHouse as the
# restricted agent_writer account (set in docker-compose.yml, not here).
# AGENT_PROVIDER: "deterministic" (default) needs no key and no network. "openai-compatible" is reserved for a later
#   task: no external provider is enabled in this slice, and selecting it makes the agent exit at startup.
# AGENT_POLL_INTERVAL_S: seconds between polls of ClickHouse, 1 to 60. Default: 2.
# AGENT_BATCH_SIZE: incidents diagnosed per cycle, 1 to 20. Default: 5.
# AGENT_REVISION_POLICY: "first-only" (default) diagnoses each incident once. "on-analyzer-change" writes a new diagnosis version when the analyzer changes.
# AGENT_PROVIDER_BASE_URL, AGENT_PROVIDER_MODEL, AGENT_PROVIDER_API_KEY: read only by a non-deterministic provider.
#   They are blank on purpose. A key never belongs in this file, in docker-compose.yml, or anywhere in the repository:
#   if you ever need one, export it in your own shell for that run only.
# AGENT_PROVIDER_ALLOW_EXTERNAL: "no" (default). "yes" would be the explicit consent to send the bounded evidence
#   bundle to a non-local provider host.
AGENT_PROVIDER=deterministic
AGENT_POLL_INTERVAL_S=2
AGENT_BATCH_SIZE=5
AGENT_REVISION_POLICY=first-only
AGENT_PROVIDER_BASE_URL=
AGENT_PROVIDER_MODEL=
AGENT_PROVIDER_API_KEY=
AGENT_PROVIDER_ALLOW_EXTERNAL=no

# --- Dashboard / API ---
WEB_PORT=3000
API_PORT=8080
