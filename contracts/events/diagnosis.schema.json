{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalforge.dev/schemas/diagnosis.schema.json",
  "title": "Diagnosis",
  "description": "Versioned, typed, evidence-cited output of the Python incident agent (version 1.1). Every supporting claim names a verifiable kind and cites evidence_id values that must exist in the evidence_items store for the same incident; the grounding validator rejects any other reference. The recommendation is descriptive text only: it is never executable and always requires approval. See docs/specs/2026-10-07-evidence-cited-diagnosis.md, section 7.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "diagnosis_id": { "$ref": "#/$defs/uuid", "description": "UUIDv5(8f3c2a9e-5d1b-4f6a-b7c8-2e9d0a1b3c4d, \"diagnosis|<incident_id>|<diagnosis_version>\")" },
    "incident_id": { "$ref": "#/$defs/uuid" },
    "diagnosis_version": { "type": "integer", "minimum": 1, "description": "Revision number of this diagnosis for the incident" },
    "status": { "type": "string", "enum": ["completed", "abstained"] },
    "abstain": { "type": "boolean", "description": "True exactly when status is abstained: the evidence is insufficient or does not match a rule the agent understands" },
    "primary_hypothesis": { "type": "string", "minLength": 1, "maxLength": 240, "description": "The likely-cause statement. Required when abstain is false; absent when true" },
    "supporting_claims": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deployment_succeeded",
              "deployment_before_failure",
              "failure_burst",
              "http_500_in_payments",
              "failures_share_deployment"
            ]
          },
          "claim": { "type": "string", "minLength": 1, "maxLength": 280 },
          "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
        },
        "required": ["kind", "claim", "evidence_ids"],
        "additionalProperties": false
      }
    },
    "alternative_hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 240 },
          "disconfirming_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 8,
            "items": { "$ref": "#/$defs/uuid" }
          }
        },
        "required": ["hypothesis", "disconfirming_evidence_ids"],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "enum": ["low", "medium", "high"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "required": ["value", "explanation"],
      "additionalProperties": false
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 },
      "description": "What would materially improve the decision. Non-empty when abstaining"
    },
    "reasoning_summary": { "type": "string", "minLength": 1, "maxLength": 1200, "description": "Bounded, human-readable, plain text" },
    "remediation_recommendation": { "$ref": "#/$defs/remediation_recommendation" },
    "provider": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "enum": ["deterministic", "openai-compatible"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fallback_from": {
          "enum": [null, "deterministic", "openai-compatible"],
          "description": "The provider whose result this one replaced, or null"
        }
      },
      "required": ["name", "model", "fallback_from"],
      "additionalProperties": false
    },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 of the canonical evidence bundle the diagnosis was made from" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "UTC timestamp with exactly three fractional digits and a Z"
    }
  },
  "required": [
    "schema_version",
    "diagnosis_id",
    "incident_id",
    "diagnosis_version",
    "status",
    "abstain",
    "supporting_claims",
    "alternative_hypotheses",
    "confidence",
    "missing_evidence",
    "reasoning_summary",
    "remediation_recommendation",
    "provider",
    "model_version",
    "prompt_version",
    "input_digest",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "abstain": { "const": false } }, "required": ["abstain"] },
      "then": {
        "required": ["primary_hypothesis"],
        "properties": {
          "status": { "const": "completed" },
          "supporting_claims": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "abstain": { "const": true } }, "required": ["abstain"] },
      "then": {
        "properties": {
          "status": { "const": "abstained" },
          "primary_hypothesis": { "not": {} },
          "supporting_claims": { "maxItems": 0 },
          "missing_evidence": { "minItems": 1 },
          "confidence": { "properties": { "value": { "const": "low" } } },
          "remediation_recommendation": { "properties": { "action_type": { "enum": ["investigate", "none"] } } }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" },
      "description": "evidence_id values that exist in evidence_items for the same incident"
    },
    "remediation_recommendation": {
      "type": "object",
      "description": "Descriptive text only. Nothing executes it, and a human approval step must precede any action (a later slice).",
      "properties": {
        "action_type": { "type": "string", "enum": ["rollback_deployment", "investigate", "none"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "parameters": {
          "type": "object",
          "properties": {
            "service": { "type": "string", "minLength": 1, "maxLength": 80 },
            "deployment_id": { "$ref": "#/$defs/uuid" },
            "from_version": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "additionalProperties": false
        },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "expected_effect": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rollback_note": { "type": "string", "minLength": 1, "maxLength": 200 },
        "executable": { "type": "boolean", "const": false },
        "requires_approval": { "type": "boolean", "const": true }
      },
      "required": ["action_type", "summary", "parameters", "risk", "expected_effect", "rollback_note", "executable", "requires_approval"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "action_type": { "const": "rollback_deployment" } }, "required": ["action_type"] },
          "then": { "properties": { "parameters": { "required": ["service", "deployment_id", "from_version"] } } }
        },
        {
          "if": { "properties": { "action_type": { "enum": ["investigate", "none"] } }, "required": ["action_type"] },
          "then": { "properties": { "parameters": { "maxProperties": 0 } } }
        }
      ]
    }
  }
}
